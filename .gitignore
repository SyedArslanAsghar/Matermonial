# Matermonial — repository ignore rules (G2).
# Secrets and environment files are owner-managed and must never be committed.

# --- Environment and secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
secrets/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# --- Django local data ---
*.log
staticfiles/
media/
*.sqlite3
celerybeat-schedule*

# --- Node (frontend / mobile) ---
node_modules/
.vite/
.expo/
web-build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors, OS and local tool settings ---
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/settings.local.json

# Local compliance-registry files (TR-24 local backend; development only)
backend/var/
