# Copy to backend/.env for local development. Names and safe placeholders only (doc 07 §11,
# doc 16 §8). Never commit backend/.env. The repository-root .env is owner-managed.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ENVIRONMENT=local
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=  (optional; leave unset to use the default)
TIME_ZONE=Asia/Karachi
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=text

# --- PostgreSQL ---
# Local development database. Tests never use it when it is on port 5432: config.settings.test
# refuses any target other than a loopback host on an approved disposable port (KI-38). Run tests
# with DATABASE_URL set in the environment (it wins over this file), for example
# postgresql://postgres:test@127.0.0.1:55432/matermonial for a throwaway container.
DATABASE_URL=postgresql://matrimonial_app:replace-this-password@127.0.0.1:5432/matrimonial_db
# Approved disposable test ports (5432 is always refused)
# TEST_DATABASE_ALLOWED_PORTS=55432,55418
DATABASE_CONN_MAX_AGE=60
DB_LOCK_TIMEOUT_MS=5000
LOCK_TRACKER_ENABLED=True

# --- API ---
API_DOCS_ENABLED=True
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# --- Notification providers (DR-2026-11-20-O-7; ADR-037; doc 16 §16) ---
# Development needs no external account. Values: mock (in memory), console (prints; local only),
# a real adapter, or disabled. Deployed environments refuse mock/console and refuse a real
# provider whose variables below are missing. Supported real adapters: Twilio (SMS), SMTP
# (email), Expo (push). Put real credentials only in the deployment secret store.
PROVIDER_TIMEOUT_SECONDS=10
# SMS: mock | console | twilio | disabled. Use console to read OTPs and admin codes locally.
SMS_PROVIDER=mock
# SMS_SENDER_ID=replace-me              (E.164 number, alphanumeric sender ID, or MG... SID)
# TWILIO_ACCOUNT_SID=replace-me
# TWILIO_AUTH_TOKEN=replace-me
# Email: mock | console | smtp | disabled
EMAIL_PROVIDER=console
# EMAIL_SENDER=no-reply@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-me
# EMAIL_HOST_PASSWORD=replace-me
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# Push: mock | console | expo | disabled
PUSH_PROVIDER=mock
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN=replace-me          (only if the Expo project uses enhanced push security)
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
STORAGE_BACKEND=local
# MEDIA_ROOT=  (optional; leave unset to use the default)

# --- Redis and Celery (optional locally: tasks run inline while eager) ---
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=  (optional; leave unset to use the default)
# CELERY_RESULT_BACKEND=  (optional; leave unset to use the default)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270

# --- Encryption, HMAC and registry keys (TR-23, TR-11, TR-24; doc 16 §10-§11) ---
# Leave unset locally: local and test settings use DEV-ONLY keys that protect nothing.
# Staging/production refuse missing or dev keys. Format: "<version>:<base64 32 bytes>,...".
# Real values come from the deployment secret store, never from this file.
# KEK_KEYS=
# KEK_ACTIVE_VERSION=1
# QUEUE_KEYS=
# QUEUE_ACTIVE_VERSION=1
# DEDUPE_KEYS=
# DEDUPE_ACTIVE_VERSION=1
# SUBJECT_HASH_KEYS=
# SUBJECT_HASH_ACTIVE_VERSION=1
# REGISTRY_KEYS=
# REGISTRY_ACTIVE_VERSION=1
# OTP_KEYS=
# OTP_ACTIVE_VERSION=1
# ROT_KEYS=
# ROT_ACTIVE_VERSION=1
# ADMIN_MFA_KEYS=
# ADMIN_MFA_ACTIVE_VERSION=1
# ACCOUNT_MFA_KEYS=                     (account authenticator seeds, TR-16)
# ACCOUNT_MFA_ACTIVE_VERSION=1

# --- Compliance registry (TR-24): "local" for development only ---
COMPLIANCE_REGISTRY_BACKEND=local
# COMPLIANCE_REGISTRY_LOCATION=

# --- Outbox (TR-11) ---
OUTBOX_LEASE_SECONDS=300
OUTBOX_REDACT_AFTER_DAYS=7
OUTBOX_PURGE_AFTER_DAYS=30

# --- One-time codes (doc 03 §2.5) ---
OTP_VALIDITY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# --- Django Admin (TR-07; doc 06 §22.2): separate session, MFA required ---
# ADMIN_URL_PATH=admin/  (use a non-default path when deployed)
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=43200
ADMIN_MFA_ENROLLMENT_TTL_SECONDS=86400
OTP_TOTP_ISSUER=Matermonial

# --- Photo uploads and malware scanning (TR-10; DR-2026-11-20-O-6, -8) ---
# MALWARE_SCANNER: mock (local/test only; flags the EICAR test string) | clamav | disabled.
# Deployed environments refuse mock; disabled refuses uploads. Unavailable scanning is never
# treated as clean. ClamAV (open source) is the supported real scanner; it needs a running clamd.
# MALWARE_SCANNER=mock
# CLAMAV_HOST=replace-me
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10
PHOTO_SCAN_MAX_ATTEMPTS=3
PHOTO_SCAN_RETRY_SECONDS=60
# Owner-approved limits: 5 MB, 4096 x 4096 px, JPEG/PNG/WebP, 6 photos, one primary.
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_DIMENSION=4096
PHOTO_MAX_PIXELS=16777216
PHOTO_MAX_EDGE=2048
PHOTO_MIN_EDGE=200
PHOTO_MAX_PER_PROFILE=6

# --- Family management (DR-2026-11-20-O-2, -3) ---
FAMILY_INVITATION_TTL_DAYS=30
FAMILY_STEP_UP_TTL_SECONDS=300
ACCOUNT_MFA_THROTTLE_FACTOR=1

# --- Cache (rate limits; Redis required when deployed) ---
# CACHE_URL=redis://127.0.0.1:6379/1
